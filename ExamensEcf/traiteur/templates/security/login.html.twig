{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="text-center mb-5">
        <h1>Connexion</h1>
        <div class="separateur-or mx-auto mt-3"></div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">

            {# Erreur #}
            {% if error %}
                <div class="alert-erreur mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="carte-sombre p-4">
                <form method="post" action="{{ path('app_login') }}">
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="username" class="form-label">Email</label>
                            <input type="email" id="username" name="email" value="{{ last_username }}"
                                   class="form-control" required autofocus>
                        </div>
                        <div class="col-12">
                            <label for="password" class="form-label">Mot de passe</label>
                            <input type="password" id="password" name="password"
                                   class="form-control" required>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
                        <a href="{{ path('app_forgot_password_request') }}" class="texte-secondaire">
                            Mot de passe oublié ?
                        </a>
                    </div>

                    <button type="submit" class="btn bouton-or w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                    </button>
                </form>
            </div>

            <div class="text-center mt-3">
                <a href="{{ path('app_register') }}" class="texte-secondaire">
                    Pas encore de compte ? S'inscrire
                </a>
            </div>

        </div>
    </div>

</div>
{% endblock %}