{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}
<h1>Mon Compte</h1>
<p>Bienvenue {{ app.user.prenom }} {{ app.user.nom }} !</p>

{% for message in app.flashes('success') %}
    <div style="color: green">{{ message }}</div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div style="color: red">{{ message }}</div>
{% endfor %}

<a href="{{ path('app_commander') }}">+ Passer une commande</a>

<h2>Mes commandes</h2>
{% if commandes is empty %}
    <p>Vous n'avez pas encore de commandes.</p>
{% else %}
    <table>
        <thead>
            <tr>
                <th>Numéro</th>
                <th>Menu</th>
                <th>Date prestation</th>
                <th>Personnes</th>
                <th>Prix total</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
            <tr>
                <td>{{ commande.numeroCommande }}</td>
                <td>{{ commande.menu.titre }}</td>
                <td>{{ commande.datePrestation|date('d/m/Y') }}</td>
                <td>{{ commande.nombrePersonne }}</td>
                <td>{{ commande.prixMenu + commande.prixLivraison }} €</td>
                <td>{{ commande.statut }}</td>
                <td>
                    {% if commande.statut == 'en_attente' %}
                        <a href="{{ path('app_commande_modifier', {id: commande.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_commande_annuler', {id: commande.id}) }}" style="display:inline">
                            <button type="submit" onclick="return confirm('Annuler cette commande ?')">Annuler</button>
                        </form>
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<ul>
<li><a href="{{ path('app_suivi_commande') }}">Suivi de mes commandes</a></li>
    <li><a href="{{ path('app_avis_nouveau') }}">Laisser un avis</a></li>
    <li><a href="{{ path('app_profil') }}">Modifier mon profil</a></li>
</ul>
{% endblock %}