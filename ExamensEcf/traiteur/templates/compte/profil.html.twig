{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-4">
        <h1>Mon Profil</h1>
        <div class="separateur-or mt-2"></div>
    </div>

    {# Formulaire #}
    <div class="carte-sombre p-4">
        {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.nom) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.prenom) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.email) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.telephone) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.adresse_postale) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.ville) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.pays) }}
                </div>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn bouton-or">
                    <i class="bi bi-person-check me-2"></i>Mettre à jour
                </button>
                <a href="{{ path('app_compte') }}" class="btn bouton-secondaire">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>
        {{ form_end(form) }}
    </div>

</div>
{% endblock %}