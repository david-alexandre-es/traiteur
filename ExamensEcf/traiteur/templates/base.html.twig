<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Traiteur Julie
			{% endblock %}
		</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('css/style.css') }}"> {% block stylesheets %}{% endblock %}
		</head>
		<body>

			<nav class="navbar navbar-expand-lg">
				<div class="container">
					<a class="navbar-brand logo-nav" href="{{ path('app_home') }}">
						Traiteur Julie
					</a>
					<button class="navbar-toggler bouton-burger" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
						<span class="navbar-toggler-icon"></span>
					</button>

					<div class="collapse navbar-collapse" id="navMenu">
						<ul class="navbar-nav mx-auto">
							<li class="nav-item">
								<a class="nav-link nav-liens" href="{{ path('app_home') }}">Accueil</a>
							</li>
							<li class="nav-item">
								<a class="nav-link nav-liens" href="{{ path('app_menus') }}">Nos menus</a>
							</li>
							<li class="nav-item">
								<a class="nav-link nav-liens" href="{{ path('app_contact') }}">Contact</a>
							</li>
							{% if app.user %}
								{% if is_granted('ROLE_ADMIN') %}
									<li class="nav-item">
										<a class="nav-link nav-liens" href="{{ path('app_admin') }}">
											<i class="bi bi-shield-lock"></i>
											Admin
										</a>
									</li>
								{% endif %}
								{% if is_granted('ROLE_EMPLOYE') %}
									<li class="nav-item">
										<a class="nav-link nav-liens" href="{{ path('app_employe') }}">
											<i class="bi bi-person-badge"></i>
											Espace Employé
										</a>
									</li>
								{% endif %}
								<li class="nav-item">
									<a class="nav-link nav-liens" href="{{ path('app_compte') }}">
										<i class="bi bi-person-circle"></i>
										{{ app.user.prenom }}
									</a>
								</li>
							{% endif %}
						</ul>

						<ul class="navbar-nav">
							{% if app.user %}
								<li class="nav-item">
									<a class="btn bouton-or ms-2" href="{{ path('app_logout') }}">
										<i class="bi bi-box-arrow-right"></i>
										Déconnexion
									</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link nav-liens" href="{{ path('app_login') }}">Se connecter</a>
								</li>
								<li class="nav-item">
									<a class="btn bouton-or ms-2" href="{{ path('app_register') }}">S'inscrire</a>
								</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</nav>

			<main>
				<div class="container">
					{% for message in app.flashes('success') %}
						<div class="alert alert-succes mt-3">
							<i class="bi bi-check-circle me-2"></i>
							{{ message }}
						</div>
					{% endfor %}
					{% for message in app.flashes('error') %}
						<div class="alert alert-erreur mt-3">
							<i class="bi bi-exclamation-triangle me-2"></i>
							{{ message }}
						</div>
					{% endfor %}
				</div>

				{% block body %}{% endblock %}
			</main>

			<footer class="footer">
				<div class="container">
					<div class="row">
						<div class="col-md-4 mb-4">
							<h5 class="footer-titre"> Traiteur Julie</h5>
							<div class="separateur-or mb-3"></div>
							<p class="footer-text">Une cuisine raffinée pour vos événements les plus précieux.</p>
						</div>
						<div class="col-md-4 mb-4">
							<h5 class="footer-titre">Horaires</h5>
							<div class="separateur-or mb-3"></div>
							<p class="footer-text">
								Lundi – Vendredi : 9h00 – 18h00<br>
								Samedi : 9h00 – 12h00<br>
								Dimanche : Fermé
							</p>
						</div>
						<div class="col-md-4 mb-4">
							<h5 class="footer-titre">Liens utiles</h5>
							<div class="separateur-or mb-3"></div>
							<p class="footer-text">
								<a href="{{ path('app_mentions_legales') }}" class="footer-liens">Mentions légales</a><br>
								<a href="{{ path('app_cgv') }}" class="footer-liens">CGV</a><br>
								<a href="{{ path('app_contact') }}" class="footer-liens">Contact</a>
							</p>
						</div>
					</div>
					<div class="footer-copy text-center">
						© 2026 Traiteur Julie — Tous droits réservés
					</div>
				</div>
			</footer>

			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
			<script src="{{ asset('js/app.js') }}"></script>
			{% block javascripts %}
				{% block importmap %}
					{{ importmap('app') }}
				{% endblock %}
			{% endblock %}
		</body>
	</html>
