{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="text-center mb-5">
        <h1>Email envoyé</h1>
        <div class="separateur-or mx-auto mt-3"></div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="carte-sombre p-4 text-center">
                <i class="bi bi-envelope-check mb-3 icone-grande"></i>
                <p class="texte-secondaire">
                    Si un compte correspond à votre adresse email, un email vient d'être envoyé avec un lien pour réinitialiser votre mot de passe.
                    Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                </p>
                <p class="texte-secondaire mb-0">
                    Si vous ne recevez pas d'email, vérifiez vos spams ou
                    <a href="{{ path('app_forgot_password_request') }}">réessayez</a>.
                </p>
            </div>
        </div>
    </div>

</div>
{% endblock %}
