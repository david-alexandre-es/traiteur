{% extends 'base.html.twig' %}

{% block title %}Espace Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-5 text-center">
        <h1>Espace Administrateur</h1>
        <div class="separateur-or mx-auto mt-3"></div>
        <p class="mt-3" style="color: var(--couleur-texte-secondaire);">
            Bienvenue {{ app.user.prenom }} {{ app.user.nom }}
        </p>
    </div>

    {# Menu admin #}
    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_menus') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-journal-richtext icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les menus</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_plats') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-egg-fried icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les plats</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_commandes') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-bag-check icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les commandes</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_utilisateurs') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-people icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les utilisateurs</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_avis') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-star icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les avis</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_allergenes') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-exclamation-triangle icone-admin"></i>
                <p class="mt-2 mb-0">Gérer les allergènes</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_stats') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-bar-chart icone-admin"></i>
                <p class="mt-2 mb-0">Statistiques</p>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('app_admin_ca') }}" class="carte-sombre p-4 d-block text-center lien-admin">
                <i class="bi bi-currency-euro icone-admin"></i>
                <p class="mt-2 mb-0">Chiffre d'affaires</p>
            </a>
        </div>
    </div>

</div>
{% endblock %}