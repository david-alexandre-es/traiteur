{% extends 'base.html.twig' %}

{% block title %}Gestion des plats{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestion des plats</h1>
            <div class="separateur-or mt-2"></div>
        </div>
        <a href="{{ path('app_admin_plat_nouveau') }}" class="btn bouton-or">
            <i class="bi bi-plus-lg me-2"></i>Nouveau plat
        </a>
    </div>

    {# Tableau #}
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Note</th>
                    <th>Allergènes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for plat in plats %}
                <tr>
                    <td>{{ plat.titrePlat }}</td>
                    <td>{{ plat.note }}</td>
                    <td>
                        {% for allergene in plat.allergenes %}
                            {{ allergene.libelle }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </td>
                    <td>
                        <a href="{{ path('app_admin_plat_modifier', {id: plat.id}) }}" class="btn bouton-secondaire btn-sm me-1">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <form method="post" action="{{ path('app_admin_plat_supprimer', {id: plat.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plat.id) }}">
                            <button type="submit" class="btn bouton-supprimer btn-sm" onclick="return confirm('Supprimer ce plat ?')">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Retour #}
    <a href="{{ path('app_admin') }}" class="btn bouton-secondaire mt-3">
        <i class="bi bi-arrow-left me-2"></i>Retour
    </a>

</div>
{% endblock %}