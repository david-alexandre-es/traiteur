{% extends 'base.html.twig' %}

{% block title %}Gestion des avis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-4">
        <h1>Gestion des avis</h1>
        <div class="separateur-or mt-2"></div>
    </div>

    {# Tableau #}
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Note</th>
                    <th>Avis</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for avis in avis %}
                <tr>
                    <td>{{ avis.utilisateur.prenom }} {{ avis.utilisateur.nom }}</td>
                    <td>{{ avis.note }}/5 ⭐</td>
                    <td>{{ avis.description }}</td>
                    <td>
                        <span class="badge-statut badge-{{ avis.statut }}">
                            {{ avis.statut }}
                        </span>
                    </td>
                    <td>
                        {% if avis.statut == 'en_attente' %}
                            <form method="post" action="{{ path('app_admin_avis_valider', {id: avis.id}) }}" class="d-inline">
                                <button type="submit" class="btn bouton-or btn-sm me-1">
                                    <i class="bi bi-check-lg"></i> Valider
                                </button>
                            </form>
                            <form method="post" action="{{ path('app_admin_avis_rejeter', {id: avis.id}) }}" class="d-inline">
                                <button type="submit" class="btn bouton-supprimer btn-sm">
                                    <i class="bi bi-x-lg"></i> Rejeter
                                </button>
                            </form>
                        {% else %}
                            <span class="texte-secondaire">—</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Retour #}
    <a href="{{ path('app_admin') }}" class="btn bouton-secondaire mt-3">
        <i class="bi bi-arrow-left me-2"></i>Retour
    </a>

</div>
{% endblock %}
