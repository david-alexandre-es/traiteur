{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-4">
        <h1>Statistiques des commandes</h1>
        <div class="separateur-or mt-2"></div>
    </div>

    {# Tableau #}
    <h2 class="mb-3">Commandes par menu</h2>
    <div class="table-responsive mb-5">
        <table class="table">
            <thead>
                <tr>
                    <th>Menu</th>
                    <th>Nombre de commandes</th>
                    <th>Chiffre d'affaires</th>
                    <th>Dernière mise à jour</th>
                </tr>
            </thead>
            <tbody>
                {% for stat in stats %}
                <tr>
                    <td>{{ stat.menuTitre }}</td>
                    <td>{{ stat.nombreCommandes }}</td>
                    <td>{{ stat.chiffreAffaires|number_format(2, ',', ' ') }} €</td>
                    <td>{{ stat.dateMAJ|date('d/m/Y H:i') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Données pour le JS #}
    <div id="stats-labels"
         data-labels='{{ stats|map(s => s.menuTitre)|json_encode|raw }}'
         hidden></div>
    <div id="stats-data"
         data-data='{{ stats|map(s => s.nombreCommandes)|json_encode|raw }}'
         hidden></div>

    {# Graphique #}
    <h2 class="mb-3">Graphique</h2>
    <div class="carte-sombre p-4">
        <canvas id="graphique"></canvas>
    </div>

    {# Retour #}
    <a href="{{ path('app_admin') }}" class="btn bouton-secondaire mt-4">
        <i class="bi bi-arrow-left me-2"></i>Retour
    </a>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/pages/stats.js') }}"></script>
{% endblock %}