{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-4">
        <h1>Gestion des commandes</h1>
        <div class="separateur-or mt-2"></div>
    </div>

    {# Tableau #}
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Numéro</th>
                    <th>Client</th>
                    <th>Menu</th>
                    <th>Date prestation</th>
                    <th>Personnes</th>
                    <th>Prix total</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                <tr>
                    <td>{{ commande.numeroCommande }}</td>
                    <td>{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</td>
                    <td>{{ commande.menu.titre }}</td>
                    <td>{{ commande.datePrestation|date('d/m/Y') }}</td>
                    <td>{{ commande.nombrePersonne }}</td>
                    <td>{{ commande.prixMenu }} €</td>
                    <td>
                        <span class="badge-statut badge-{{ commande.statut }}">
                            {{ commande.statut }}
                        </span>
                    </td>
                    <td>
                        <form method="post" action="{{ path('app_admin_commande_statut', {id: commande.id}) }}" class="d-inline-flex gap-1">
                            <select name="statut" class="form-select form-select-sm">
                                <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                                <option value="confirmee" {% if commande.statut == 'confirmee' %}selected{% endif %}>Confirmée</option>
                                <option value="en_preparation" {% if commande.statut == 'en_preparation' %}selected{% endif %}>En préparation</option>
                                <option value="livree" {% if commande.statut == 'livree' %}selected{% endif %}>Livrée</option>
                                <option value="annulee" {% if commande.statut == 'annulee' %}selected{% endif %}>Annulée</option>
                            </select>
                            <button type="submit" class="btn bouton-or btn-sm">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Retour #}
    <a href="{{ path('app_admin') }}" class="btn bouton-secondaire mt-3">
        <i class="bi bi-arrow-left me-2"></i>Retour
    </a>

</div>
{% endblock %}