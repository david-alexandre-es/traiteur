{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs
{% endblock %}

{% block body %}
	<h1>Gestion des utilisateurs</h1>

	{% for message in app.flashes('success') %}
		<div style="color: green">{{ message }}</div>
	{% endfor %}

	<table>
		<thead>
			<tr>
				<th>Nom</th>
				<th>Prénom</th>
				<th>Email</th>
				<th>Rôle</th>
                <th>Actif</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for utilisateur in utilisateurs %}
				<tr>
					<td>{{ utilisateur.nom }}</td>
					<td>{{ utilisateur.prenom }}</td>
					<td>{{ utilisateur.email }}</td>
					<td>{{ utilisateur.role.value }}</td>
                    <td>{{ utilisateur.isActif() ? 'Oui' : 'Non' }}</td>
					<td>
						<form method="post" action="{{ path('app_admin_utilisateur_role', {id: utilisateur.id}) }}" style="display:inline">
							<select name="role">
								<option value="ROLE_USER" {% if utilisateur.role.value == 'ROLE_USER' %} selected {% endif %}>Utilisateur</option>
								<option value="ROLE_EMPLOYE" {% if utilisateur.role.value == 'ROLE_EMPLOYE' %} selected {% endif %}>Employé</option>
								<option value="ROLE_ADMIN" {% if utilisateur.role.value == 'ROLE_ADMIN' %} selected {% endif %}>Admin</option>
							</select>
							<button type="submit">Changer</button>
						</form>
						<form method="post" action="{{ path('app_admin_utilisateur_supprimer', {id: utilisateur.id}) }}" style="display:inline">
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ utilisateur.id) }}">
							<button type="submit" onclick="return confirm('Supprimer cet utilisateur ?')">Supprimer</button>
						</form>
						<form method="post" action="{{ path('app_admin_utilisateur_toggle_actif', {id: utilisateur.id}) }}" style="display:inline">
							<button type="submit">
								{% if utilisateur.isActif() %}Désactiver{% else %}Activer{% endif %}
							</button>
						</form>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_admin') }}">← Retour</a>
{% endblock %}
