{% extends 'base.html.twig' %}

{% block title %}Images du menu
	{{ menu.titre }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
	<div
		class="container py-5">

		{# Titre #}
		<div class="mb-4">
			<h1>Images —
				{{ menu.titre }}</h1>
			<div class="separateur-or mt-2"></div>
		</div>

		{# Ajouter une image #}
		<div class="carte-sombre p-4 mb-5">
			<h2 class="mb-4">Ajouter une image</h2>
			{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
			{{ form_row(form.imageFile) }}
			<button type="submit" class="btn bouton-or mt-3">
				<i class="bi bi-upload me-2"></i>Ajouter
			</button>
			{{ form_end(form) }}
		</div>

		{# Images actuelles #}
		<h2 class="mb-4">Images actuelles</h2>

		{% if menu.images is empty %}
			<p class="texte-vide">Aucune image pour ce menu.</p>
		{% else %}
			<div class="row g-3">
				{% for image in menu.images %}
					<div class="col-md-3 col-sm-6">
						<div class="carte-sombre p-2 text-center">
							<img src="{{ vich_uploader_asset(image, 'imageFile') }}" alt="Image menu" class="img-fluid image-menu mb-2">
							<form method="post" action="{{ path('app_admin_menu_image_supprimer', {id: image.id}) }}">
								<button type="submit" class="btn bouton-supprimer btn-sm w-100" onclick="return confirm('Supprimer cette image ?')">
									<i class="bi bi-trash"></i>
									Supprimer
								</button>
							</form>
						</div>
					</div>
				{% endfor %}
			</div>
		{% endif %}

		{# Retour #}
		<a href="{{ path('app_admin_menus') }}" class="btn bouton-secondaire mt-4">
			<i class="bi bi-arrow-left me-2"></i>Retour aux menus
		</a>

	</div>
{% endblock %}
