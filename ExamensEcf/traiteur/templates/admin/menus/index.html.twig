{% extends 'base.html.twig' %}

{% block title %}Gestion des menus{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestion des menus</h1>
            <div class="separateur-or mt-2"></div>
        </div>
        <a href="{{ path('app_admin_menu_nouveau') }}" class="btn bouton-or">
            <i class="bi bi-plus-lg me-2"></i>Nouveau menu
        </a>
    </div>

    {# TABLEAU #}
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Prix / personne</th>
                    <th>Thème</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                <tr>
                    <td>{{ menu.titre }}</td>
                    <td>{{ menu.prixParPersonne }} €</td>
                    <td>{{ menu.theme.libelle }}</td>
                    <td>
                        <a href="{{ path('app_admin_menu_modifier', {id: menu.id}) }}" class="btn bouton-secondaire btn-sm me-1">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <a href="{{ path('app_admin_menu_images', {id: menu.id}) }}" class="btn bouton-secondaire btn-sm me-1">
                            <i class="bi bi-image"></i> Images
                        </a>
                        <form method="post" action="{{ path('app_admin_menu_supprimer', {id: menu.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}">
                            <button type="submit" class="btn bouton-supprimer btn-sm" onclick="return confirm('Supprimer ce menu ?')">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# RETOUR #}
    <a href="{{ path('app_admin') }}" class="btn bouton-secondaire mt-3">
        <i class="bi bi-arrow-left me-2"></i>Retour
    </a>

</div>
{% endblock %}