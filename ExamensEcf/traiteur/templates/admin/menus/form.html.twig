{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<h1>{{ titre }}</h1>

{{ form_start(form) }}
    {{ form_row(form.titre) }}
    {{ form_row(form.description) }}
    {{ form_row(form.prix_par_personne) }}
    {{ form_row(form.nombre_personne_minimum) }}
    {{ form_row(form.quantite_restante) }}
    {{ form_row(form.theme) }}
    {{ form_row(form.regimes) }}
    {{ form_row(form.plats) }}

    <button type="submit">Enregistrer</button>
{{ form_end(form) }}

<a href="{{ path('app_admin_menus') }}">← Retour</a>
{% endblock %}