{% extends 'base.html.twig' %}

{% block title %}Annuler la commande{% endblock %}

{% block body %}
<div class="container py-5">

    {# Titre #}
    <div class="mb-4">
        <h1>Annuler la commande {{ commande.numeroCommande }}</h1>
        <div class="separateur-or mt-2"></div>
    </div>

    {# Infos commande #}
    <div class="carte-sombre p-4 mb-4">
        <div class="row">
            <div class="col-md-4">
                <p class="mb-1 texte-secondaire">Client</p>
                <p class="mb-0">{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</p>
            </div>
            <div class="col-md-4">
                <p class="mb-1 texte-secondaire">Menu</p>
                <p class="mb-0">{{ commande.menu.titre }}</p>
            </div>
            <div class="col-md-4">
                <p class="mb-1 texte-secondaire">Date prestation</p>
                <p class="mb-0">{{ commande.datePrestation|date('d/m/Y') }}</p>
            </div>
        </div>
    </div>

    {# Avertissement #}
    <div class="alerte-avertissement mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Avant d'annuler cette commande, vous devez avoir contacté le client par appel GSM ou mail.
    </div>

    {# Formulaire #}
    <div class="carte-sombre p-4">
        {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.mode_contact) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.motif_annulation) }}
                </div>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn bouton-supprimer" onclick="return confirm('Confirmer l\'annulation ?')">
                    <i class="bi bi-x-circle me-2"></i>Annuler la commande
                </button>
                <a href="{{ path('app_employe') }}" class="btn bouton-secondaire">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>
        {{ form_end(form) }}
    </div>

</div>
{% endblock %}